{
  "name": "biodanza-music-player",
  "productName": "Biodanza Music Player",
  "version": "5.6.0",
  "description": "נגן מיון ואפיון מוזיקה לביודנסה - גרסת Electron",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never",
    "build:setup": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.biodanza.musicplayer",
    "productName": "Biodanza Music Player",
    "files": [
      "index.html",
      "folder-controls.js",
      "workspace-controls.js",
      "language-update.js",
      "relink-upgrade.js",
      "relink-safety-upgrade.js",
      "logical-song-upgrade.js",
      "data-store-upgrade.js",
      "recovery-export.js",
      "database-display-upgrade.js",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {"output":"dist"},
    "win": {"target":[{"target":"nsis","arch":["x64"]}]},
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Biodanza Music Player",
      "uninstallDisplayName": "Biodanza Music Player",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "artifactName": "Biodanza Music Player Setup 5.6.0.${ext}",
    "asar": true
  }
}
